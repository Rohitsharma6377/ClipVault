<Page
    x:Class="ClipVault.Views.ClipboardListPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ClipVault.Models"
    xmlns:viewmodels="using:ClipVault.ViewModels"
    mc:Ignorable="d"
    x:Name="PageRoot">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="HeaderTitle" 
                   Text="Clipboard History" 
                   Style="{StaticResource TitleTextBlockStyle}"
                   Margin="0,0,0,12"/>

        <ListView Grid.Row="1"
                  ItemsSource="{x:Bind ViewModel.ClipboardItems, Mode=OneWay}"
                  SelectionMode="None"
                  Padding="0,0,0,20">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:ClipboardItem">
                    <Grid Padding="12" Margin="0,4" 
                          Background="{ThemeResource LayerFillColorDefaultBrush}"
                          CornerRadius="8"
                          BorderThickness="1"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Content}" 
                                       MaxLines="2" 
                                       TextWrapping="Wrap" 
                                       TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource BodyTextBlockStyle}"/>
                            <TextBlock Text="{x:Bind TimestampLabel}" 
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Opacity="0.6"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                            <Button Content="&#xE8C8;" FontFamily="Segoe MDL2 Assets" 
                                    Command="{Binding ElementName=PageRoot, Path=ViewModel.CopyCommand}"
                                    CommandParameter="{x:Bind}"
                                    ToolTipService.ToolTip="Copy"
                                    Style="{StaticResource SubtleButtonStyle}"/>
                            
                            <ToggleButton Content="&#xE718;" FontFamily="Segoe MDL2 Assets" 
                                          IsChecked="{x:Bind IsPinned, Mode=TwoWay}"
                                          Command="{Binding ElementName=PageRoot, Path=ViewModel.TogglePinCommand}"
                                          CommandParameter="{x:Bind}"
                                          ToolTipService.ToolTip="Pin"
                                          Style="{StaticResource SubtleButtonStyle}"/>

                            <Button Content="&#xE74D;" FontFamily="Segoe MDL2 Assets" 
                                    Command="{Binding ElementName=PageRoot, Path=ViewModel.DeleteCommand}"
                                    CommandParameter="{x:Bind}"
                                    ToolTipService.ToolTip="Delete"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Style="{StaticResource SubtleButtonStyle}"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>

        <ProgressRing Grid.Row="1" 
                      IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                      Width="32" Height="32"/>
    </Grid>
</Page>
