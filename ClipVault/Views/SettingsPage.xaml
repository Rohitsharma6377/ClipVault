<Page
    x:Class="ClipVault.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24">
        <StackPanel Spacing="24" MaxWidth="600" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}"/>

            <StackPanel Spacing="12">
                <TextBlock Text="Appearance" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <ToggleSwitch Header="Mica Backdrop" IsOn="True" />
                <ComboBox Header="Theme" SelectedIndex="0" HorizontalAlignment="Stretch">
                    <ComboBoxItem Content="System Default"/>
                    <ComboBoxItem Content="Light"/>
                    <ComboBoxItem Content="Dark"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Spacing="12">
                <TextBlock Text="Data" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <ToggleSwitch Header="Launch at Startup" />
                <ToggleSwitch Header="Save history to disk" IsOn="True" />
                <Button Content="Clear History" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock Text="About" Style="{StaticResource BodyStrongTextBlockStyle}"/>
                <TextBlock Text="ClipVault v1.0.0" Opacity="0.7"/>
                <TextBlock Text="© 2026 ClipVault Developer" Opacity="0.7"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
